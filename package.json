{
  "name": "hod-marketplace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "sync:vision": "node scripts/sync-vision-assets.mjs",
    "prebuild": "node scripts/sync-vision-assets.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite",
    "dev:backend": "npm --prefix server start",
