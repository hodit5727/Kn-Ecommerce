    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jpeg-js": "^0.4.4",
    "nodemailer": "^10.0.10",
    "pngjs": "^7.0.0",
    "ws": "^8.22.0"
