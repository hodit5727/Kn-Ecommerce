# ─────────────────────────────────────────────────────────────────────────────
# Environment template — VARIABLE NAMES ONLY, never real values.
#
# Copy to `.env` (backend) / `.env.local` (frontend overrides). `.env*` is
# git-ignored except this example (see .gitignore).
#
# MANDATORY RULES (AGENTS.md §2 / spec §2):
#   * If a REQUIRED variable is missing, the server must FAIL CLEARLY at
#     startup with a configuration error — never silently fall back to mock
#     mode, never use hardcoded credentials, never invent values.
#   * NEVER hardcode keys/passwords/secrets anywhere in source code.
#   * VITE_* values are BUNDLED INTO THE PUBLIC BROWSER BUILD — only public
#     values may use that prefix. Service-role keys, SMTP credentials, Gemini
#     keys, JWT/session secrets and admin credentials are SERVER-ONLY.
# ─────────────────────────────────────────────────────────────────────────────

# ═══════════════════ FRONTEND (Vite — PUBLIC, bundled) ═══════════════════
# Express backend base URL (public API endpoint only)
VITE_API_BASE_URL=/api/v1
# Public Supabase values (safe to expose). The service-role key NEVER goes here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# PostHog project analytics (public project key)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
# Application URL (used for links/redirects)
VITE_APP_URL=http://localhost:5173

# ═══════════════════ BACKEND (Express — SERVER-ONLY) ═════════════════════
PORT=3001
APP_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
# CORS allowlist (comma-separated origins). Never `*` with credentials.
CORS_ORIGINS=http://localhost:5173

# ── Supabase (Auth + PostgreSQL + Storage) ────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Privileged server-side operations ONLY. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Session cookie / token signing + lifetime
SESSION_SECRET=
SESSION_TTL_MINUTES=60

# ── Email / SMTP (professional HTML templates; also backs Auth OTP mail) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=K-Shop
# How long OTP / PIN-reset codes stay valid (minutes)
OTP_TTL_MINUTES=10
PIN_RESET_TTL_MINUTES=15

# ── Gemini (server-side product assistance, image checks — NEVER VITE_) ───
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash

# ── PostHog analytics (server-side business events) ───────────────────────
POSTHOG_KEY=
POSTHOG_HOST=

# ── Admin bootstrap (spec §4: dedicated admin login, provisioned
#    server-side on first startup; strong password set here or generated at
#    runtime and printed once — NEVER committed, NEVER in frontend code) ───
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
